# =======================================================
# Production Deployment Environment Configuration
# Pure MySQL Database & Security Settings
# =======================================================

# Enforce pure MySQL (set to mysql or REQUIRE_MYSQL=true)
DB_TYPE=mysql
REQUIRE_MYSQL=true

# MySQL Database Connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=buildtrack_user
MYSQL_PASSWORD=your_strong_mysql_password
MYSQL_DATABASE=buildtrack_ams
MYSQL_SSL=false

# Application Security
PORT=3000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key_2026