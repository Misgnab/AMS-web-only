# Application Environment
NODE_ENV=production
PORT=3000

# Authentication & Security
JWT_SECRET=your_ultra_secure_jwt_secret_min_32_characters

# Enterprise MySQL Database Configuration (Pure MySQL Architecture)
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=buildtrack_ams
MYSQL_SSL=false