# BuildTrack AMS - Production Nginx Reverse Proxy Configuration
# Place this file in /etc/nginx/sites-available/buildtrack.conf
# Enable with: sudo ln -s /etc/nginx/sites-available/buildtrack.conf /etc/nginx/sites-enabled/

# 1. HTTP Server Block (Redirect to HTTPS)
server {
    listen 80;
    listen [::]:80;
    server_name attendance.nabitechplc.com;

    # Allow Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Redirect all HTTP traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. HTTPS Server Block (SSL/TLS Termination)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name attendance.nabitechplc.com;

    # SSL Certificates (managed automatically by certbot --nginx)
    # ssl_certificate /etc/letsencrypt/live/attendance.nabitechplc.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/attendance.nabitechplc.com/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Security Headers for Enterprise Hardening
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Client body limit for file/photo uploads and data sync
    client_max_body_size 30M;

    # Gzip Compression for Fast Mobile Loading
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/javascript application/xml application/json;

    # Proxy to Node.js / Express backend
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Request Headers & Real Client IP
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Buffer & Timeout settings
        proxy_buffers 8 32k;
        proxy_buffer_size 64k;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Static assets caching optimization
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg)$ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }
}
